{
  "schema": "newx.deerflow.agent.acceptance.v1",
  "scope": "semantic_core",
  "deerflow_revision": "5851f8250eb150ca23134c79b11ebc5073ac2789",
  "cases": [
    {
      "id": "core.flash.direct",
      "mode": "flash",
      "input_prompt": "请仅回复：语义核心直答已收到。",
      "actions": [{ "type": "run" }],
      "expect": {
        "capabilities": { "plan": false, "subagent": false },
        "assistant_message_required": true,
        "token_usage_required": true,
        "required_terminal": ["success"],
        "required_events": [
          "run.started",
          "assistant.completed",
          "token.usage",
          "run.completed"
        ],
        "event_order": [
          ["run.started", "assistant.completed"],
          ["assistant.completed", "run.completed"]
        ]
      }
    },
    {
      "id": "core.thinking.direct",
      "mode": "thinking",
      "input_prompt": "计算 37 乘以 19，只给出结果。",
      "actions": [{ "type": "run" }],
      "expect": {
        "capabilities": { "thinking": true, "plan": false, "subagent": false },
        "assistant_message_required": true,
        "token_usage_required": true,
        "required_terminal": ["success"],
        "required_events": [
          "run.started",
          "assistant.completed",
          "token.usage",
          "run.completed"
        ],
        "event_order": [
          ["run.started", "assistant.completed"],
          ["assistant.completed", "run.completed"]
        ]
      }
    },
    {
      "id": "core.pro.todo",
      "mode": "pro",
      "input_prompt": "请制定三步检查计划，逐项完成后用一句话总结。",
      "actions": [{ "type": "run" }, { "type": "reload_state" }],
      "expect": {
        "capabilities": { "thinking": true, "plan": true, "subagent": false },
        "assistant_message_required": true,
        "token_usage_required": true,
        "todo": { "required": true, "all_completed": true },
        "required_terminal": ["success"],
        "required_events": [
          "run.started",
          "todo.updated",
          "assistant.completed",
          "run.completed"
        ],
        "event_order": [
          ["run.started", "todo.updated"],
          ["todo.updated", "run.completed"]
        ]
      }
    },
    {
      "id": "core.ultra.subagents",
      "mode": "ultra",
      "input_prompt": "并行让两个子任务分别列出 2 个偶数和 2 个奇数，最后合并。",
      "actions": [{ "type": "run" }],
      "expect": {
        "capabilities": { "thinking": true, "subagent": true },
        "assistant_message_required": true,
        "token_usage_required": true,
        "children": { "minimum": 2 },
        "required_terminal": ["success"],
        "required_events": [
          "run.started",
          "subagent.started",
          "subagent.completed",
          "assistant.completed",
          "run.completed"
        ],
        "event_order": [
          ["run.started", "subagent.started"],
          ["subagent.started", "subagent.completed"],
          ["subagent.completed", "run.completed"]
        ]
      }
    },
    {
      "id": "core.clarify.followup",
      "mode": "pro",
      "input_prompt": "先向我确认使用方案 A 还是方案 B；得到回答前不要继续。",
      "actions": [
        { "type": "run" },
        { "type": "follow_up", "answer": "方案 A" }
      ],
      "expect": {
        "capabilities": {},
        "assistant_message_required": true,
        "token_usage_required": true,
        "clarification": { "required": true, "follow_up_required": true },
        "required_terminal": ["success"],
        "required_events": [
          "run.started",
          "clarification.requested",
          "followup.started",
          "assistant.completed",
          "followup.completed"
        ],
        "event_order": [
          ["run.started", "clarification.requested"],
          ["clarification.requested", "followup.started"],
          ["followup.started", "followup.completed"]
        ]
      }
    },
    {
      "id": "core.cancel",
      "mode": "pro",
      "input_prompt": "执行一个需要等待的多步骤检查，未完成前不要提前总结。",
      "actions": [
        { "type": "run" },
        { "type": "cancel", "after_event": "run.started" }
      ],
      "expect": {
        "capabilities": {},
        "no_success_after_cancel": true,
        "required_terminal": ["cancelled"],
        "required_events": ["run.started", "run.cancelled"],
        "event_order": [["run.started", "run.cancelled"]]
      }
    },
    {
      "id": "core.stream.reconnect",
      "mode": "flash",
      "input_prompt": "按顺序输出数字 1、2、3。",
      "actions": [
        { "type": "run" },
        { "type": "reconnect", "after_events": 1 }
      ],
      "expect": {
        "capabilities": { "plan": false, "subagent": false },
        "assistant_message_required": true,
        "token_usage_required": true,
        "reconnect_deduplicated": true,
        "required_terminal": ["success"],
        "required_events": [
          "run.started",
          "assistant.completed",
          "run.completed"
        ],
        "event_order": [
          ["run.started", "assistant.completed"],
          ["assistant.completed", "run.completed"]
        ]
      }
    }
  ]
}
