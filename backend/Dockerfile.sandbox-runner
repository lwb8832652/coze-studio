ARG GIT_REVISION=unknown
ARG SOURCE_URL=unknown

FROM golang:1.24-alpine AS builder

WORKDIR /src
RUN apk add --no-cache git gcc libc-dev
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
# The shared Sandbox persistence helpers use the SQLite driver's Go error type
# for duplicate-key normalization, so keep CGO enabled just as the main server
# image does. The final Alpine image carries the required musl runtime.
RUN go build -trimpath -ldflags="-s -w" -o /out/sandbox-runner ./cmd/sandbox-runner

FROM alpine:3.22.0@sha256:8a1f59ffb675680d47db6337b49d22281a139e9d709335b492be023728e11715
ARG GIT_REVISION
ARG SOURCE_URL

LABEL org.opencontainers.image.title="newx-sandbox-runner"
LABEL org.opencontainers.image.revision=$GIT_REVISION
LABEL org.opencontainers.image.source=$SOURCE_URL

RUN apk add --no-cache ca-certificates && \
    addgroup -S -g 10001 sandbox && \
    adduser -S -D -H -u 10001 -G sandbox sandbox && \
    install -d -o 10001 -g 10001 -m 0700 /app/runtime /app/secrets

COPY --from=builder /out/sandbox-runner /app/sandbox-runner

USER 10001:10001
EXPOSE 9443
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

ENTRYPOINT ["/app/sandbox-runner"]
