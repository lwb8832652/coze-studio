# Deployment-only settings. Keep application secrets in the server-local app.env;
# keep the OceanBase container password in the server-local deploy.env.
ACR_REGISTRY=registry.example.aliyuncs.com
ACR_NAMESPACE=example
SERVER_IMAGE_TAG=dev
WEB_IMAGE_TAG=dev
WEB_BIND_IP=0.0.0.0
WEB_PORT=8888
DEPLOY_HEALTH_TIMEOUT_SECONDS=120
# Keep `local-data` unless the remote MySQL/Redis/Elasticsearch/object-storage
# app.env and dedicated rootless runtime socket are prepared.
DEPLOY_PROFILE=local-data
SANDBOX_RUNNER_IMAGE_TAG=dev
SANDBOX_RUNTIME_IMAGE_TAG=dev
# Required only for DEPLOY_PROFILE=runner-2c4g. This is the socket owned by the
# dedicated rootless runtime user, never /var/run/docker.sock.
SANDBOX_RUNNER_ROOTLESS_SOCKET=
SANDBOX_RUNNER_ROOTLESS_SOCKET_GID=
# Required on the server; keep the real value in the server-local deploy.env.
OCEANBASE_PASSWORD=
OCEANBASE_DATAFILE_SIZE=1G
OCEANBASE_MEM_LIMIT=2g
OCEANBASE_CPUS=1.00
